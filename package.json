{
  "name": "karaca-md-editor",
  "displayName": "Karaca MD",
  "description": "%description%",
  "version": "0.1.14",
  "publisher": "berkantkaraca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berkantkaraca/markdown-editor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCustomEditor:karaca.mdEditor",
    "onView:karacaOutline",
    "onView:karacaBacklinks"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "karaca.mdEditor",
        "displayName": "Karaca MD Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "karacaOutline",
          "name": "%view.karacaOutline%"
        },
        {
          "id": "karacaBacklinks",
          "name": "%view.karacaBacklinks%"
        }
      ]
    },
    "commands": [
      {
        "command": "karaca-md.openLive",
        "title": "%karaca-md.openLive%",
        "category": "Karaca"
      },
      {
        "command": "karaca-md.showSource",
        "title": "%karaca-md.showSource%",
        "category": "Karaca"
      },
      {
        "command": "karaca-md.newNote",
        "title": "%karaca-md.newNote%",
        "category": "Karaca"
      },
      {
        "command": "karaca-md.dailyNote",
        "title": "%karaca-md.dailyNote%",
        "category": "Karaca"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "karaca-md.openLive",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "karaca-md.showSource",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "karaca-md.newNote"
        },
        {
          "command": "karaca-md.dailyNote"
        }
      ]
    },
    "configuration": {
      "title": "Karaca MD Editor",
      "properties": {
        "karacaMd.defaultMode": {
          "type": "string",
          "enum": [
            "live",
            "source",
            "split",
            "reading"
          ],
          "default": "live",
          "description": "%config.defaultMode%"
        },
        "karacaMd.wordWrap": {
          "type": "boolean",
          "default": true,
          "description": "%config.wordWrap%"
        },
        "karacaMd.lineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%config.lineNumbers%"
        },
        "karacaMd.language": {
          "type": "string",
          "enum": [
            "en",
            "tr"
          ],
          "enumDescriptions": [
            "English",
            "Türkçe"
          ],
          "default": "en",
          "scope": "application",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "lint": "tsc --noEmit",
    "pretest": "node esbuild.js --only=test-bundle",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "test:browser": "node esbuild.js --only=test-bundle && node --test test/browser.cjs",
    "test:extension-host": "npm run compile && node --test test/extension-host.cjs",
    "test:cross-browser": "node esbuild.js --only=test-bundle && node test/run-browsers.cjs",
    "test:performance": "node esbuild.js --only=test-bundle && node test/run-performance.cjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.2",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.33.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.9.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "author": {
    "name": "berkantkaraca"
  },
  "icon": "media/icon.png"
}
